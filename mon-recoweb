#!/usr/bin/env bash
# NAME=mon-recoweb
# VERSION=3.0.0
# DESCRIPTION=Reconnaissance web automatisée avec dirb et ffuf, avec scans ciblés de répertoires et fichiers.
# PRESENTATION_START
# **mon-recoweb — Reconnaissance web automatisée**
#
# `mon-recoweb` automatise plusieurs étapes de reconnaissance web et regroupe
# les résultats dans un seul fichier de synthèse.
#
# Il combine trois phases basées sur des outils bien connus : `dirb` et `ffuf`.
# Leur utilisation complémentaire permet d’obtenir une reconnaissance web
# plus approfondie, avec une couverture optimisée des répertoires et fichiers.
#
# Dans le cas le plus simple :
#
# ```bash
# mon-recoweb cible.htb
# ```
#
# Le script lance successivement :
#
# 1. `dirb` pour une première découverte ;
# 2. `ffuf` pour les répertoires ;
# 3. `ffuf` pour les fichiers.
#
# Les résultats sont regroupés dans :
#
# ```text
# RESULTS_SUMMARY.txt
# ```
#
# ## Scanner un répertoire précis
#
# ```bash
# mon-recoweb cible.htb/cgi-bin/
# ```
#
# Le scan reste alors limité à ce chemin.
#
# ## Tester des extensions
#
# ```bash
# mon-recoweb cible.htb/cgi-bin/ --ext sh,cgi,pl
# ```
#
# ## Filtrer les résultats parasites des ffuf
#
# Certaines applications renvoient beaucoup de réponses parasites.
# Un filtre simple peut suffire, par exemple sur la taille :
#
# ```bash
# mon-recoweb cible.htb \
#   --ffuf-extra "-fs 1234"
# ```
#
# ou sur le code HTTP :
#
# ```bash
# mon-recoweb cible.htb \
#   --ffuf-extra "-fc 302"
# ```
#
# Pour un filtrage plus précis, tu peux combiner code HTTP et taille :
#
# ```bash
# mon-recoweb cible.htb \
#   --no-dirb \
#   --no-ffuf-dirs \
#   --ffuf-extra "-fc 302,401 -fs 97,49,125 -fmode and"
# ```
#
# Avec `-fmode and`, les critères sont combinés.
#
# Si `ffuf-files` et `ffuf-dirs` nécessitent des filtres différents, lance-les
# séparément ou en parallèle. Les résultats sont fusionnés dans
# `RESULTS_SUMMARY.txt`.
#
# ## Pour aller plus loin
#
# ```bash
# mon-recoweb --help-advanced
# ```
# PRESENTATION_END
#
# HOMEPAGE=https://github.com/NoelNac-HackEthical/mes-scripts
#____________________________________________________________________________
#
# Bref résumé :
#   Reconnaissance web automatisée en 3 phases avec dirb et ffuf,
#   détection soft-404 et résumé global persistant.
#

set -euo pipefail

# ---------------------------------------------------------------------------
# Helpers version (ne pas modifier)
_self_path="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1; then
  _resolved="$(readlink -f -- "$_self_path" 2>/dev/null || true)"
  [ -n "$_resolved" ] && _self_path="$_resolved"
fi
_self_base="$(basename "$_self_path")"

_version_str(){
  local v
  v="$(awk -F= '/^# *VERSION *=/ { gsub(/\r$/,"",$2); print $2; exit }' "$_self_path" 2>/dev/null || true)"
  v="${v:-0.0.0}"
  printf '%s v%s\n' "$_self_base" "$v"
}

_print_version_and_exit(){
  _version_str
  exit 0
}
# ---------------------------------------------------------------------------

usage(){
  cat <<USAGE
Usage:
  ${_self_base} <cible>
  ${_self_base} <cible>/<répertoire>/
  ${_self_base} <cible>/<répertoire>/ --ext <extensions>

Exemples:
  ${_self_base} cible.htb
  ${_self_base} cible.htb/cgi-bin/
  ${_self_base} cible.htb/cgi-bin/ --ext sh,cgi,pl

Par défaut, ${_self_base} lance automatiquement :
  1. dirb
  2. ffuf directories
  3. ffuf files

Les résultats sont regroupés dans :
  RESULTS_SUMMARY.txt

Options courantes:
  --ext <liste>          Extensions à tester avec ffuf-files
                        Exemple : --ext php,txt,bak

  -h, --help             Afficher cette aide
  --help-advanced        Afficher les options avancées
  -V, --version          Afficher la version

Pour les filtres, les wordlists, le lancement séparé des phases
et les autres réglages :
  ${_self_base} --help-advanced
USAGE
}

usage_advanced(){
  cat <<USAGE
Usage avancé:
  ${_self_base} [OPTIONS] <cible>
  ${_self_base} [OPTIONS] -t <cible>

Cible:
  cible.htb
  http://10.10.10.10
  cible.htb/cgi-bin/

Phases:
  --no-dirb              Ne pas lancer dirb
  --no-ffuf-dirs         Ne pas lancer ffuf directories
  --no-ffuf-files        Ne pas lancer ffuf files

  Les phases peuvent être lancées séparément.
  Les résultats sont fusionnés dans RESULTS_SUMMARY.txt.

Ciblage:
  -s, --scheme <http|https>
                         Schéma utilisé si la cible est un host
                         Défaut : http

  --base <path>          Définir un chemin de base
                         Exemple : --base /app

  --ext <liste>          Extensions testées par ffuf-files
                         Exemple : --ext php,txt,bak

Filtres ffuf:
  --fc <codes>           Codes HTTP à filtrer
                         Défaut : 404

  --fs <size>            Taille de réponse à filtrer
                         Prioritaire sur la détection automatique

  --ffuf-extra <opts>    Options supplémentaires transmises à ffuf

Performance:
  -T, --threads <n>      Nombre de threads ffuf
                         Défaut : 30

  --rate <n>             Limite de requêtes par seconde

  --timeout <sec>        Timeout ffuf
                         Défaut : 10

Wordlists:
  --dirb-wordlist <path> Wordlist utilisée par dirb
  --raft-dirs <path>     Wordlist utilisée par ffuf directories
  --raft-files <path>    Wordlist utilisée par ffuf files

Sortie:
  -o, --outdir <dir>     Dossier de sortie

Autres options:
  -t, --target <cible>   Définir explicitement la cible
  --debug                Activer le mode debug
  -h, --help             Aide simplifiée
  --help-advanced        Aide avancée
  -V, --version          Version

Exemple — ffuf-files seul:
  ${_self_base} cible.htb \\
    --no-dirb \\
    --no-ffuf-dirs \\
    --ffuf-extra "-fc 302,401 -fs 97,49,125 -fmode and"

Exemple — ffuf-dirs seul:
  ${_self_base} cible.htb \\
    --no-dirb \\
    --no-ffuf-files \\
    --ffuf-extra "-fc 302 -fs 97 -fmode and"

Les différentes phases peuvent être lancées dans plusieurs terminaux.
Leur écriture dans RESULTS_SUMMARY.txt est synchronisée.
USAGE
}

# ---------------------------------------------------------------------------
# Parsing CLI
DEBUG=false

if [[ "${1:-}" == "--version" || "${1:-}" == "-V" ]]; then
  _print_version_and_exit
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  _version_str
  usage
  exit 0
fi

if [[ "${1:-}" == "--help-advanced" ]]; then
  _version_str
  usage_advanced
  exit 0
fi

TARGET=""
SCHEME="http"
BASE="/"
THREADS=30
RATE=""
TIMEOUT=10
FFUF_FC="404"
FFUF_FS=""
FFUF_EXTRA_OPTS=""

EXT_RAW=""
FFUF_EXTS=""

DIRB_WORDLIST="/usr/share/wordlists/dirb/common.txt"
RAFT_DIRS="/usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt"
RAFT_FILES="/usr/share/seclists/Discovery/Web-Content/raft-medium-files.txt"
RAFT_FILES_EXPLICIT=false

OUTDIR="scans_recoweb"

DO_DIRB=true
DO_FFUF_DIRS=true
DO_FFUF_FILES=true

ORIGINAL_CMDLINE="$(printf '%q ' "$0" "$@")"
ORIGINAL_CMDLINE="${ORIGINAL_CMDLINE% }"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug)
      DEBUG=true
      shift
      ;;

    -V|--version)
      _print_version_and_exit
      ;;

    -h|--help)
      _version_str
      usage
      exit 0
      ;;
      
    --help-advanced)
      _version_str
      usage_advanced
      exit 0
      ;;      

    -t|--target)
      TARGET="${2:-}"
      shift 2
      ;;

    -s|--scheme)
      SCHEME="${2:-}"
      shift 2
      ;;

    --base)
      BASE="${2:-}"
      shift 2
      ;;

    --ext)
      EXT_RAW="${2:-}"
      shift 2
      ;;

    -T|--threads)
      THREADS="${2:-}"
      shift 2
      ;;

    --rate)
      RATE="${2:-}"
      shift 2
      ;;

    --timeout)
      TIMEOUT="${2:-}"
      shift 2
      ;;

    --fc)
      FFUF_FC="${2:-}"
      shift 2
      ;;

    --fs)
      FFUF_FS="${2:-}"
      shift 2
      ;;

    --ffuf-extra)
      FFUF_EXTRA_OPTS="${2:-}"
      shift 2
      ;;

    --dirb-wordlist)
      DIRB_WORDLIST="${2:-}"
      shift 2
      ;;

    --raft-dirs)
      RAFT_DIRS="${2:-}"
      shift 2
      ;;

    --raft-files)
      RAFT_FILES="${2:-}"
      RAFT_FILES_EXPLICIT=true
      shift 2
      ;;

    -o|--outdir)
      OUTDIR="${2:-}"
      shift 2
      ;;

    --no-dirb)
      DO_DIRB=false
      shift
      ;;

    --no-ffuf-dirs)
      DO_FFUF_DIRS=false
      shift
      ;;

    --no-ffuf-files)
      DO_FFUF_FILES=false
      shift
      ;;

    --)
      shift
      break
      ;;

    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;

    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
        shift
      else
        echo "ERROR: argument inattendu: $1" >&2
        usage
        exit 2
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Normalisation --ext
if [[ -n "${EXT_RAW:-}" ]]; then
  EXT_RAW="${EXT_RAW// /}"

  IFS=',' read -r -a _ext_arr <<< "$EXT_RAW"

  _out=()

  for e in "${_ext_arr[@]}"; do
    [[ -n "$e" ]] || continue

    [[ "$e" == .* ]] || e=".$e"

    _out+=("$e")
  done

  FFUF_EXTS="$(IFS=,; echo "${_out[*]}")"

  if [[ -z "$FFUF_EXTS" ]]; then
    echo "ERROR: --ext fourni mais aucune extension valide après normalisation." >&2
    exit 2
  fi
fi

_need_cmd(){
  command -v "$1" >/dev/null 2>&1 || {
    echo "ERROR: missing command: $1" >&2
    exit 127
  }
}

_need_file(){
  [ -f "$1" ] || {
    echo "ERROR: missing file: $1" >&2
    exit 1
  }
}

_norm_base(){
  local b="$1"

  [ -z "$b" ] && b="/"

  [[ "$b" != /* ]] && b="/$b"
  [[ "$b" != "/" ]] && b="${b%/}"

  printf '%s' "$b"
}

_is_full_url(){
  [[ "$1" =~ ^https?:// ]]
}

_split_host_and_path(){
  local t="$1"

  if _is_full_url "$t"; then
    printf "%s\t%s\n" "$t" ""
    return 0
  fi

  if [[ "$t" == */* ]]; then
    local host="${t%%/*}"
    local path="/${t#*/}"

    path="${path%/}"

    printf "%s\t%s\n" "$host" "$path"
    return 0
  fi

  printf "%s\t%s\n" "$t" ""
}

_build_base_url(){
  local t="$1"
  local s="$2"
  local b="$3"

  b="$(_norm_base "$b")"

  if _is_full_url "$t"; then
    [[ "$b" == "/" ]] \
      && echo "${t%/}" \
      || echo "${t%/}${b}"
  else
    [[ "$b" == "/" ]] \
      && echo "${s}://${t}" \
      || echo "${s}://${t}${b}"
  fi
}

_check_target_accessible(){
  local t="$1"
  local base_url="${2:-}"

  if _is_full_url "$t"; then
    curl -ksI --max-time 5 "$t" >/dev/null 2>&1
    return $?
  fi

  if [[ -n "$base_url" ]]; then
    curl -ksI --max-time 5 "${base_url%/}/" >/dev/null 2>&1 && return 0
  fi

  nc -z -w2 "$t" 80 >/dev/null 2>&1 && return 0
  nc -z -w2 "$t" 443 >/dev/null 2>&1 && return 0

  return 1
}

_detect_soft404_size(){
  local base_url="$1"
  local probe="__monrecoweb_probe_${RANDOM}_${RANDOM}__"
  local url="${base_url%/}/${probe}"

  local code

  code="$(curl -s \
    -o /dev/null \
    -w "%{http_code}" \
    --max-time 5 \
    "$url" 2>/dev/null || true)"

  if [[ "$code" == "200" ]]; then
    local size

    size="$(curl -s --max-time 5 "$url" 2>/dev/null \
      | wc -c \
      | tr -d ' ' || true)"

    [[ -n "$size" && "$size" =~ ^[0-9]+$ ]] && echo "$size"
  fi
}

_fmt_duration(){
  local s="${1:-0}"

  [[ "$s" =~ ^[0-9]+$ ]] || s=0

  local h=$((s/3600))
  local m=$(((s%3600)/60))
  local r=$((s%60))

  if (( h > 0 )); then
    printf "%dh%02dm%02ds" "$h" "$m" "$r"
  elif (( m > 0 )); then
    printf "%dm%02ds" "$m" "$r"
  else
    printf "%ds" "$r"
  fi
}

_ffuf_export_txt_from_json(){
  local json="$1"
  local out_txt="$2"
  local out_hits="$3"

  if command -v jq >/dev/null 2>&1; then
    {
      echo "ffuf results"
      echo
      echo "Generated: $(date)"
      echo "Source   : $json"
      echo "------------------------------------------------"
      echo

      jq -r '
        .results[]
        | "\(.input.FUZZ)\t[Status: \(.status), Size: \(.length), Words: \(.words), Lines: \(.lines), Duration: \(.duration)]"
      ' "$json" | column -t -s $'\t'
    } > "$out_txt"

    jq -r '
      .results[]
      | "\(.input.FUZZ)\t[Status: \(.status), Size: \(.length), Words: \(.words), Lines: \(.lines), Duration: \(.duration)]"
    ' "$json" \
      | column -t -s $'\t' > "$out_hits"
  else
    : > "$out_txt"
    : > "$out_hits"
  fi
}

_warn_ffuf_zero_hits(){
  local label="$1"
  local json="$2"

  command -v jq >/dev/null 2>&1 || return 0
  [[ -s "$json" ]] || return 0

  local n

  n="$(jq '.results | length' "$json" 2>/dev/null || echo 0)"

  if [[ "${n:-0}" -eq 0 ]]; then
    printf "%b\n" \
      "${C_ALERT}[!] ALERT:${C_RESET} ffuf ${label} → 0 résultat"

    printf "%b\n" \
      "${C_WARN}[!] Suggestion:${C_RESET} vérifier 2-3 fichiers clés à la main (robots.txt, sitemap.xml) et ajuster threads/rate/filters."
  fi
}

_warn_dirb_files_but_ffuf_files_zero(){
  local dirb_hits="$1"
  local json_files="$2"

  command -v jq >/dev/null 2>&1 || return 0
  [[ -s "$dirb_hits" && -s "$json_files" ]] || return 0

  local dirb_files
  local ffuf_files

  dirb_files="$(awk 'NF && $0 !~ /\/$/' "$dirb_hits" \
    | wc -l \
    | tr -d ' ' || true)"

  ffuf_files="$(jq '.results | length' "$json_files" 2>/dev/null || echo 0)"

  if [[ "${dirb_files:-0}" -gt 0 && "${ffuf_files:-0}" -eq 0 ]]; then
    printf "%b\n" \
      "${C_ALERT}[!] ALERT:${C_RESET} dirb a trouvé des fichiers (${dirb_files}) MAIS ffuf files = 0"

    printf "%b\n" \
      "${C_INFO}[!] Interprétation:${C_RESET} wildcard/soft-404 variable, filtres trop stricts, ou serveur qui réagit différemment."

    printf "%b\n" \
      "${C_WARN}[!] Action:${C_RESET} retester les URLs trouvées par dirb au curl, puis ajuster ffuf (t/rate/-fs/-fw/-fl)."
  fi
}

_outdir_suffix_from_base(){
  local b="$1"

  b="$(_norm_base "$b")"

  [[ "$b" == "/" ]] && {
    echo ""
    return 0
  }

  local s="${b##*/}"

  s="${s//[^A-Za-z0-9._-]/_}"

  echo "$s"
}

_is_ipv4(){
  local h="$1"

  [[ "$h" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1

  IFS='.' read -r a b c d <<< "$h"

  for n in "$a" "$b" "$c" "$d"; do
    [[ "$n" =~ ^[0-9]+$ ]] || return 1

    (( n >= 0 && n <= 255 )) || return 1
  done

  return 0
}

_extract_host_from_url(){
  local url="$1"
  local h

  h="$(printf '%s' "$url" \
    | sed -E 's#^https?://([^/]+).*#\1#')"

  h="${h%%:*}"

  printf '%s' "$h"
}

_outdir_suffix_from_host(){
  local t="$1"
  local host=""

  if _is_full_url "$t"; then
    host="$(_extract_host_from_url "$t")"
  else
    host="$t"
  fi

  if _is_ipv4 "$host"; then
    echo ""
    return 0
  fi

  host="${host//[^A-Za-z0-9._-]/_}"

  echo "$host"
}

write_results_header(){
  local summary_file="$1"

  {
    echo "===== ${NAME} — RÉSUMÉ DES RÉSULTATS ====="
    echo "Commande principale : ${CMDLINE}"
    echo "Script              : ${NAME} v${VERSION}"
    echo
    echo "Cible        : ${TARGET_HOST_HDR}"
    echo "Périmètre    : ${TARGET_SCOPE_HDR}"
    echo "Date début   : ${NOW}"
    echo
    echo "Processus de génération des résultats :"
    echo "- Les sorties JSON temporaires produites par ffuf constituent la source de vérité pendant l'exécution."
    echo "- Les entrées pertinentes sont extraites via jq (URL, code HTTP, taille de réponse)."
    echo "- Les réponses assimilables à des soft-404 sont filtrées par comparaison des tailles et des codes HTTP."
    echo "- Les URLs finales sont reconstruites à partir du périmètre scanné."
    echo "- Les résultats sont normalisés sous la forme :"
    echo "    http://cible/chemin (CODE:xxx|SIZE:yyy)"
    echo "- Les résultats de chaque phase sont conservés dans RESULTS_SUMMARY.txt."
    echo "- Une phase désactivée conserve les résultats de sa dernière exécution."
    echo
    echo "----------------------------------------------------"
    echo
  } > "$summary_file"
}

# ---------------------------------------------------------------------------
# Couleurs
if [[ -t 1 ]]; then
  C_ALERT=$'\e[1;31m'
  C_WARN=$'\e[1;33m'
  C_INFO=$'\e[1;36m'
  C_RESET=$'\e[0m'
else
  C_ALERT=""
  C_WARN=""
  C_INFO=""
  C_RESET=""
fi

# ---------------------------------------------------------------------------

_main(){
  if [ "$DEBUG" = true ]; then
    set -x
  fi

  echo "Script: $(_version_str)"

  if [[ -z "$TARGET" ]]; then
    echo "ERROR: missing target (use -t <target> or provide it as positional argument)" >&2
    usage
    exit 2
  fi

  _need_cmd ffuf
  _need_cmd curl
  _need_cmd flock

  if $DO_DIRB; then
    _need_cmd dirb
    _need_file "$DIRB_WORDLIST"
  fi

  local split
  local host
  local base_from_target

  split="$(_split_host_and_path "$TARGET")"

  host="$(printf '%s' "$split" | cut -f1)"
  base_from_target="$(printf '%s' "$split" | cut -f2)"

  local TARGET_HOST="$host"

  if [[ -n "$base_from_target" ]]; then
    BASE="$base_from_target"
  fi

  BASE="$(_norm_base "$BASE")"

  if [[ "$BASE" != "/" && "$RAFT_FILES_EXPLICIT" = false ]]; then
    RAFT_FILES="/usr/share/wordlists/dirb/common.txt"
  fi

  if $DO_FFUF_DIRS; then
    _need_file "$RAFT_DIRS"
  fi

  if $DO_FFUF_FILES; then
    _need_file "$RAFT_FILES"
  fi

  local BASE_URL

  if _is_full_url "$TARGET"; then
    BASE_URL="$(_build_base_url "$TARGET" "$SCHEME" "$BASE")"
  else
    BASE_URL="$(_build_base_url "$TARGET_HOST" "$SCHEME" "$BASE")"
  fi

  echo "[*] Test d'accessibilité de la cible"

  local ACCESS_T="$TARGET"

  _is_full_url "$TARGET" || ACCESS_T="$TARGET_HOST"

  if ! _check_target_accessible "$ACCESS_T" "$BASE_URL"; then
    echo "[!] Aucune réponse TCP immédiate depuis $ACCESS_T."
    echo "[!] L'IP de $ACCESS_T est peut être incorrecte (reset HTB ?)."
    echo "[!] Vérifie l'IP dans l'interface HTB"
    echo "[!] et /etc/hosts si tu utilises un nom de domaine."
    echo
    echo "[!] Arrêt du script."
    exit 1
  fi

  echo "[+] Cible accessible"

  local SOFT404_SIZE=""

  SOFT404_SIZE="$(_detect_soft404_size "$BASE_URL")"

  if [[ -n "$SOFT404_SIZE" ]]; then
    echo "[*] Soft-404 détectée : 200 sur inexistant → ffuf utilisera -fs $SOFT404_SIZE"
    echo "[!] ATTENTION : si le contenu varie (taille instable), tu peux rater des hits."
    echo "[!] Conseil : en phase exploitation, reteste les fichiers importants au curl."
  fi

  local EFFECTIVE_FS=""

  if [[ -n "$FFUF_FS" ]]; then
    EFFECTIVE_FS="$FFUF_FS"
    echo "[*] --fs fourni par l'utilisateur → priorité à -fs $EFFECTIVE_FS"
  else
    EFFECTIVE_FS="$SOFT404_SIZE"
  fi

  # -------------------------------------------------------------------------
  # OUTDIR
  local OUT_HOST_SUFFIX
  local OUT_BASE_SUFFIX

  OUT_HOST_SUFFIX="$(_outdir_suffix_from_host "$ACCESS_T")"
  OUT_BASE_SUFFIX="$(_outdir_suffix_from_base "$BASE")"

  if [[ -n "$OUT_HOST_SUFFIX" ]]; then
    OUTDIR="${OUTDIR%/}/$OUT_HOST_SUFFIX"
  fi

  if [[ -n "$OUT_BASE_SUFFIX" ]]; then
    OUTDIR="${OUTDIR%/}/$OUT_BASE_SUFFIX"
  fi

  mkdir -p "$OUTDIR"

  local RATE_EFFECTIVE="$RATE"

  echo "[*] target : $TARGET"
  echo "[*] host   : $TARGET_HOST"
  echo "[*] base   : $BASE_URL"
  echo "[*] outdir : $OUTDIR"
  echo "[*] files wordlist : $RAFT_FILES"

  if [[ -n "$FFUF_EXTS" ]]; then
    echo "[*] ext    : $FFUF_EXTS"
  fi

  if [[ -n "$RATE_EFFECTIVE" ]]; then
    echo "[*] ffuf   : threads=$THREADS rate=$RATE_EFFECTIVE timeout=${TIMEOUT}s fc=$FFUF_FC"
  else
    echo "[*] ffuf   : threads=$THREADS timeout=${TIMEOUT}s fc=$FFUF_FC"
  fi

  if [[ -n "${FFUF_EXTRA_OPTS:-}" ]]; then
    echo "[*] ffuf extra : $FFUF_EXTRA_OPTS"
  fi

  if [[ -n "${FFUF_FS:-}" ]]; then
    echo "[*] ffuf fs explicite : $FFUF_FS"
  fi

  # -------------------------------------------------------------------------
  # Fichiers temporaires des trois phases

  local LOG_DIRB
  local HITS_DIRB

  local LOG_FFUF_DIRS
  local JSON_DIRS
  local TXT_DIRS
  local HITS_DIRS

  local LOG_FFUF_FILES
  local JSON_FILES
  local TXT_FILES
  local HITS_FILES

  LOG_DIRB="$(mktemp)"
  HITS_DIRB="$(mktemp)"

  LOG_FFUF_DIRS="$(mktemp)"
  JSON_DIRS="$(mktemp)"
  TXT_DIRS="$(mktemp)"
  HITS_DIRS="$(mktemp)"

  LOG_FFUF_FILES="$(mktemp)"
  JSON_FILES="$(mktemp)"
  TXT_FILES="$(mktemp)"
  HITS_FILES="$(mktemp)"

  local SUMMARY_FILE="$OUTDIR/RESULTS_SUMMARY.txt"
  local PREV_SUMMARY=""
  local SUMMARY_LOCK="/tmp/mon-recoweb-${UID}-$(printf '%s' "$(readlink -f "$SUMMARY_FILE")" | cksum | awk '{print $1}').lock"

  # -------------------------------------------------------------------------
  # Phase 1 : DIRB

  if $DO_DIRB; then
    echo
    echo "[+] Phase 1/3: dirb (common.txt)"

    dirb "${BASE_URL%/}/" "$DIRB_WORDLIST" -r \
      | tee "$LOG_DIRB" || true

    tr -d '\r' < "$LOG_DIRB" \
    | sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' \
    | awk '
        match($0, /\+ (https?:\/\/[^ ]+)/, m) {
          print m[1]
          next
        }

        match($0, /==> DIRECTORY: (https?:\/\/[^ ]+)/, m) {
          print m[1]
          next
        }
      ' \
    | sort -u > "$HITS_DIRB" || true
  else
    echo
    echo "[!] Phase 1/3: dirb skipped (--no-dirb)"
  fi

  # -------------------------------------------------------------------------
  # Phase 2 : FFUF DIRECTORIES

  if $DO_FFUF_DIRS; then
    echo
    echo "[+] Phase 2/3: ffuf directories"

    ffuf -u "${BASE_URL%/}/FUZZ" \
      -w "$RAFT_DIRS" \
      -t "$THREADS" \
      ${RATE_EFFECTIVE:+-rate "$RATE_EFFECTIVE"} \
      -timeout "$TIMEOUT" \
      -fc "$FFUF_FC" \
      ${EFFECTIVE_FS:+-fs "$EFFECTIVE_FS"} \
      ${FFUF_EXTRA_OPTS:+$FFUF_EXTRA_OPTS} \
      -of json \
      -o "$JSON_DIRS" \
      2>&1 | tee "$LOG_FFUF_DIRS"

    _ffuf_export_txt_from_json \
      "$JSON_DIRS" \
      "$TXT_DIRS" \
      "$HITS_DIRS"

    echo

    _warn_ffuf_zero_hits "directories" "$JSON_DIRS"
  else
    echo
    echo "[!] Phase 2/3: ffuf dirs skipped (--no-ffuf-dirs)"
  fi

  # -------------------------------------------------------------------------
  # Phase 3 : FFUF FILES

  if $DO_FFUF_FILES; then
    echo
    echo "[+] Phase 3/3: ffuf files"

    ffuf -u "${BASE_URL%/}/FUZZ" \
      -w "$RAFT_FILES" \
      -t "$THREADS" \
      ${RATE_EFFECTIVE:+-rate "$RATE_EFFECTIVE"} \
      -timeout "$TIMEOUT" \
      -fc "$FFUF_FC" \
      ${EFFECTIVE_FS:+-fs "$EFFECTIVE_FS"} \
      ${FFUF_EXTS:+-e "$FFUF_EXTS"} \
      ${FFUF_EXTRA_OPTS:+$FFUF_EXTRA_OPTS} \
      -of json \
      -o "$JSON_FILES" \
      2>&1 | tee "$LOG_FFUF_FILES"

    _ffuf_export_txt_from_json \
      "$JSON_FILES" \
      "$TXT_FILES" \
      "$HITS_FILES"

    echo

    _warn_ffuf_zero_hits "files" "$JSON_FILES"

    _warn_dirb_files_but_ffuf_files_zero \
      "$HITS_DIRB" \
      "$JSON_FILES"
  else
    echo
    echo "[!] Phase 3/3: ffuf files skipped (--no-ffuf-files)"
  fi

  # -------------------------------------------------------------------------
  # Contexte résumé

  local SUMMARY_TARGET

  if [[ "$BASE" == "/" ]]; then
    SUMMARY_TARGET="${TARGET_HOST}/"
  else
    SUMMARY_TARGET="${TARGET_HOST}${BASE}/"
  fi

  NOW="$(date '+%Y-%m-%d %H:%M:%S')"

  CMDLINE="$ORIGINAL_CMDLINE"


  NAME="$(awk -F= '
    /^# *NAME *=/ {
      gsub(/\r$/,"",$2)
      print $2
      exit
    }
  ' "$_self_path" 2>/dev/null || true)"

  NAME="${NAME:-${_self_base}}"

  VERSION="$(awk -F= '
    /^# *VERSION *=/ {
      gsub(/\r$/,"",$2)
      print $2
      exit
    }
  ' "$_self_path" 2>/dev/null || true)"

  VERSION="${VERSION:-0.0.0}"

  TARGET_DISPLAY="${SUMMARY_TARGET}"

  TARGET_HOST_HDR="$TARGET_HOST"

  if [[ "$BASE" == "/" ]]; then
    TARGET_SCOPE_HDR="/"
  else
    TARGET_SCOPE_HDR="${BASE}/"
  fi

  # -------------------------------------------------------------------------
  # Commandes exactes

  if $DO_DIRB; then
    _dirb_core="$(printf '%q ' \
      dirb \
      "${BASE_URL%/}/" \
      "$DIRB_WORDLIST" \
      -r)"

    _dirb_core="${_dirb_core% }"

    DIRB_CMD="${_dirb_core}"
  else
    DIRB_CMD="(dirb skipped --no-dirb)"
  fi

  if $DO_FFUF_DIRS; then
    _ffuf_dirs_core="$(printf '%q ' \
      ffuf \
      -u "${BASE_URL%/}/FUZZ" \
      -w "$RAFT_DIRS" \
      -t "$THREADS" \
      ${RATE_EFFECTIVE:+-rate "$RATE_EFFECTIVE"} \
      -timeout "$TIMEOUT" \
      -fc "$FFUF_FC" \
      ${EFFECTIVE_FS:+-fs "$EFFECTIVE_FS"} \
      ${FFUF_EXTRA_OPTS:+$FFUF_EXTRA_OPTS})"

    _ffuf_dirs_core="${_ffuf_dirs_core% }"

    FFUF_DIRS_CMD="${_ffuf_dirs_core}"
  else
    FFUF_DIRS_CMD="(ffuf dirs skipped --no-ffuf-dirs)"
  fi

  if $DO_FFUF_FILES; then
    _ffuf_files_core="$(printf '%q ' \
      ffuf \
      -u "${BASE_URL%/}/FUZZ" \
      -w "$RAFT_FILES" \
      -t "$THREADS" \
      ${RATE_EFFECTIVE:+-rate "$RATE_EFFECTIVE"} \
      -timeout "$TIMEOUT" \
      -fc "$FFUF_FC" \
      ${EFFECTIVE_FS:+-fs "$EFFECTIVE_FS"} \
      ${FFUF_EXTS:+-e "$FFUF_EXTS"} \
      ${FFUF_EXTRA_OPTS:+$FFUF_EXTRA_OPTS})"

    _ffuf_files_core="${_ffuf_files_core% }"

    FFUF_FILES_CMD="${_ffuf_files_core}"
  else
    FFUF_FILES_CMD="(ffuf files skipped --no-ffuf-files)"
  fi

  exec 9>"$SUMMARY_LOCK"
  flock -x 9

  if [[ -f "$SUMMARY_FILE" ]]; then
    PREV_SUMMARY="$(mktemp)"
    cp -- "$SUMMARY_FILE" "$PREV_SUMMARY"
  fi

  write_results_header "$SUMMARY_FILE"

  # -------------------------------------------------------------------------
  # RESULTS_SUMMARY

  {
    echo "=== Résultat global (agrégé) ==="
    echo

    {
      # ---------------------------------------------------------------------
      # DIRB : courant ou conservé

      if $DO_DIRB; then
        if [[ -s "$LOG_DIRB" ]]; then
          tr -d '\r' < "$LOG_DIRB" \
          | sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' \
          | awk '
              match($0, /\+ (https?:\/\/[^ ]+) \(CODE:([0-9]+)\|SIZE:([0-9]+)\)/, m) {
                print m[1] " (CODE:" m[2] "|SIZE:" m[3] ")"
                next
              }

              match($0, /==> DIRECTORY: (https?:\/\/[^ ]+)/, m) {
                print m[1]
                next
              }
            ' \
          | sort -u
        fi
      else
        if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
          awk '
            /^\[DIRB\]$/ {
              capture=1
              next
            }

            /^\[FFUF — DIRECTORIES\]$/ {
              capture=0
            }

            capture && $0 != "(aucun résultat)" {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        fi
      fi

      # ---------------------------------------------------------------------
      # FFUF DIRECTORIES : courant ou conservé

      if $DO_FFUF_DIRS; then
        if [[ -s "$JSON_DIRS" ]] && command -v jq >/dev/null 2>&1; then
          jq -r \
            --arg base "${BASE_URL%/}/" '
              .results[]
              | "\($base)\(.input.FUZZ)/ (CODE:\(.status)|SIZE:\(.length))"
            ' \
            "$JSON_DIRS" 2>/dev/null || true
        fi
      else
        if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
          awk '
            /^\[FFUF — DIRECTORIES\]$/ {
              capture=1
              next
            }

            /^\[FFUF — FILES\]$/ {
              capture=0
            }

            capture && $0 != "(aucun résultat)" {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        fi
      fi

      # ---------------------------------------------------------------------
      # FFUF FILES : courant ou conservé

      if $DO_FFUF_FILES; then
        if [[ -s "$JSON_FILES" ]] && command -v jq >/dev/null 2>&1; then
          jq -r \
            --arg base "${BASE_URL%/}/" '
              .results[]
              | "\($base)\(.input.FUZZ) (CODE:\(.status)|SIZE:\(.length))"
            ' \
            "$JSON_FILES" 2>/dev/null || true
        fi
      else
        if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
          awk '
            /^\[FFUF — FILES\]$/ {
              capture=1
              next
            }

            capture && $0 != "(aucun résultat)" {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        fi
      fi

    } | sed '/^$/d' \
      | sort -u \
      | awk '
          {
            key=$0

            if (match(key, / \(CODE:[0-9]+\|SIZE:[0-9]+\)$/)) {
              meta=substr(key, RSTART)
              url=substr(key, 1, RSTART-1)

              sub(/\/$/, "", url)

              key=url meta
            }

            if (!seen[key]++) {
              print
            }
          }
        '

    echo
    echo "=== Détails par outil ==="
    echo

    # -----------------------------------------------------------------------
    # DIRB détaillé

    echo "[DIRB]"

    if $DO_DIRB; then
      if [[ -s "$LOG_DIRB" ]]; then
        tr -d '\r' < "$LOG_DIRB" \
        | sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g' \
        | awk '
            match($0, /\+ (https?:\/\/[^ ]+) \(CODE:([0-9]+)\|SIZE:([0-9]+)\)/, m) {
              print m[1] " (CODE:" m[2] "|SIZE:" m[3] ")"
              next
            }

            match($0, /==> DIRECTORY: (https?:\/\/[^ ]+)/, m) {
              print m[1]
              next
            }
          ' \
        | sort -u
      else
        echo "(aucun résultat)"
      fi
    else
      if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
        _prev_dirb="$(
          awk '
            /^\[DIRB\]$/ {
              capture=1
              next
            }

            /^\[FFUF — DIRECTORIES\]$/ {
              capture=0
            }

            capture {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        )"

        if [[ -n "$_prev_dirb" ]]; then
          printf '%s\n' "$_prev_dirb"
        else
          echo "(aucun résultat)"
        fi
      else
        echo "(aucun résultat)"
      fi
    fi

    echo

    # -----------------------------------------------------------------------
    # FFUF DIRECTORIES détaillé

    echo "[FFUF — DIRECTORIES]"

    if $DO_FFUF_DIRS; then
      if [[ -s "$JSON_DIRS" ]] && command -v jq >/dev/null 2>&1; then
        jq -r \
          --arg base "${BASE_URL%/}/" '
            .results[]
            | "\($base)\(.input.FUZZ)/ (CODE:\(.status)|SIZE:\(.length))"
          ' \
          "$JSON_DIRS" 2>/dev/null \
        | sort -u || true
      else
        echo "(aucun résultat)"
      fi
    else
      if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
        _prev_ffuf_dirs="$(
          awk '
            /^\[FFUF — DIRECTORIES\]$/ {
              capture=1
              next
            }

            /^\[FFUF — FILES\]$/ {
              capture=0
            }

            capture {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        )"

        if [[ -n "$_prev_ffuf_dirs" ]]; then
          printf '%s\n' "$_prev_ffuf_dirs"
        else
          echo "(aucun résultat)"
        fi
      else
        echo "(aucun résultat)"
      fi
    fi

    echo

    # -----------------------------------------------------------------------
    # FFUF FILES détaillé

    echo "[FFUF — FILES]"

    if $DO_FFUF_FILES; then
      if [[ -s "$JSON_FILES" ]] && command -v jq >/dev/null 2>&1; then
        jq -r \
          --arg base "${BASE_URL%/}/" '
            .results[]
            | "\($base)\(.input.FUZZ) (CODE:\(.status)|SIZE:\(.length))"
          ' \
          "$JSON_FILES" 2>/dev/null \
        | sort -u || true
      else
        echo "(aucun résultat)"
      fi
    else
      if [[ -n "$PREV_SUMMARY" && -s "$PREV_SUMMARY" ]]; then
        _prev_ffuf_files="$(
          awk '
            /^\[FFUF — FILES\]$/ {
              capture=1
              next
            }

            capture {
              print
            }
          ' "$PREV_SUMMARY" \
          | sed '/^[[:space:]]*$/d'
        )"

        if [[ -n "$_prev_ffuf_files" ]]; then
          printf '%s\n' "$_prev_ffuf_files"
        else
          echo "(aucun résultat)"
        fi
      else
        echo "(aucun résultat)"
      fi
    fi

  } >> "$SUMMARY_FILE"
  flock -u 9
  exec 9>&-

  # -------------------------------------------------------------------------
  # Nettoyage de tous les fichiers temporaires

  rm -f -- \
    "$LOG_DIRB" \
    "$HITS_DIRB" \
    "$LOG_FFUF_DIRS" \
    "$JSON_DIRS" \
    "$TXT_DIRS" \
    "$HITS_DIRS" \
    "$LOG_FFUF_FILES" \
    "$JSON_FILES" \
    "$TXT_FILES" \
    "$HITS_FILES"

  if [[ -n "$PREV_SUMMARY" ]]; then
    rm -f -- "$PREV_SUMMARY"
  fi

  echo
  echo "[+] Outputs:"
  echo "    - $SUMMARY_FILE"

  echo
  echo "[+] Résultat global:"
  echo

  sed 's/^/  /' "$SUMMARY_FILE"

  echo
  echo "[OK] Done."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  _main "$@"
fi
